urce_supported_not_certified_verbatim","sourceSupportedTranscription":"[问题7] 该小礼物的外包装是一个圆柱（底面直径为$8\\,\\mathrm{cm}$，高为$10\\,\\mathrm{cm}$），至少需要多长的彩带？","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U06","requestedPath":"increments/u05-u06-v1/evidence/U06/page-11.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U06.docx","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:book3:U06:para269:ribbon-unfolding:11","sourceId":"U06","sourceSha256":"0402aecedce4977bf1f7c135c742d95342095eea13ce47ea2ab70012c3394ab4","locator":{"headingPath":["活动1 包装彩带问题"],"part":"word/document.xml","paragraphIndex":269,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":11,"printedPage":null,"pdfPage":11,"equationObjectId":null},"quote":"本阶段是拓展研究多面体与旋转体展开图的几何特征．对于问题5，教师可提示学生先把侧面展开，再把上下底面与合适的侧面相接；问题6与问题5相似，也可以说是包粽子问题；问题7是旋转体问题．教师可借助立体几何模型，和学生一起通过实物操作，并引导学生将空间问题展开转化到平面上解决．本阶段活动对空间想象能力的要求较高，需教师根据学生的实际情况酌情选用．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U06","requestedPath":"increments/u05-u06-v1/evidence/U06/page-11.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U06.docx","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:book3:U06:para271:ribbon-unfolding:12","sourceId":"U06","sourceSha256":"0402aecedce4977bf1f7c135c742d95342095eea13ce47ea2ab70012c3394ab4","locator":{"headingPath":["活动1 包装彩带问题"],"part":"word/document.xml","paragraphIndex":271,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":11,"printedPage":null,"pdfPage":11,"equationObjectId":null},"quote":"通过交流和讨论，问题5中，学生寻找到合适的捆扎方法比较困难，要求能够通过操作找到合适的展开方法，并且说理正确，计算无误；有了问题5的经验问题6通常可以相对顺利一些，也可以倒过来，先研究问题6，平面数相对较少容易总体把握，有了经验后再回头研究问题5；问题7要求学生能够理解旋转体的展开，需通过建立合适的函数来求最值，由于现阶段数学工具不足，可通过计算器列表等求得近似值即可．在探究过程中，学生能够认真参与操作与研究，积极发表讨论自己的见解和观点，可以根据学生参与讨论的程度作出评价．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U06","requestedPath":"increments/u05-u06-v1/evidence/U06/page-11.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U06.docx","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:book3:U06:para273:ribbon-unfolding:13","sourceId":"U06","sourceSha256":"0402aecedce4977bf1f7c135c742d95342095eea13ce47ea2ab70012c3394ab4","locator":{"headingPath":["活动1 包装彩带问题"],"part":"word/document.xml","paragraphIndex":273,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":12,"printedPage":null,"pdfPage":12,"equationObjectId":null},"quote":"本活动是教材必修第三册“11.1柱体”、“11.2锥体”内容学习结束的跨课时活动．本活动以包装彩带为情境，以多面体与旋转体的展开图为研究起点，研究折线段在几何体表面的最值问题．通过这项实践研究，加深对空间图形表面结构的理解和用展开图把空间问题转化为平面问题的自觉度，提高综合运用立体几何知识研究身边几何问题的能力，积累研究相关问题的活动经验．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U06","requestedPath":"increments/u05-u06-v1/evidence/U06/page-12.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U06.docx","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:book3:U06:para274:ribbon-unfolding:14","sourceId":"U06","sourceSha256":"0402aecedce4977bf1f7c135c742d95342095eea13ce47ea2ab70012c3394ab4","locator":{"headingPath":["活动1 包装彩带问题"],"part":"word/document.xml","paragraphIndex":274,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":12,"printedPage":null,"pdfPage":12,"equationObjectId":null},"quote":"本活动共分两个阶段，可根据学生的实际情况酌情选择只完成第1阶段，或完成全部两个阶段；完成时间也可选择1课时内完成，或用2课时完成．本探究活动还可增加圆锥，不过需对彩带捆绑方式做进一步的约定．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U06","requestedPath":"increments/u05-u06-v1/evidence/U06/page-12.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U06.docx","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:DOT-R10:U06:ad0b62aae2782538","sourceId":"U06","sourceSha256":"0402aecedce4977bf1f7c135c742d95342095eea13ce47ea2ab70012c3394ab4","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","locator":{"headingPath":["活动1 包装彩带问题","DOT已交局部来源"],"part":"original-reflow-page-07.png","renderedPage":7,"pageNumberConvention":"同摘要原件的既有重排页号；原冻结定位另存"},"quote":"同字节复用已交局部原页或原生对象；开放任务、源错误与编辑补足分别保留。未重转原件、未作整源审校。","resource":{"url":"r80/assets/8d746b17e4ea6e3b09139007.png","bytes":475203,"sha256":"8d746b17e4ea6e3b09139007cfa34ca5d3f0900ef7aa9605b7870d6543d6c02f","sourceId":"U06","kind":"same_hash_original_reflow_page"},"originalUrl":"source-original/U06.docx","originalPdfUrl":"source-original/dot-r10/8e760780f3ae5fca7389b55a.pdf"},{"id":"ev:DOT-R10:U06:db763d5bec3094ff","sourceId":"U06","sourceSha256":"0402aecedce4977bf1f7c135c742d95342095eea13ce47ea2ab70012c3394ab4","sourceTitle":"必修三 第10单元 简单几何体 单元教学设计","locator":{"headingPath":["活动1 包装彩带问题","DOT已交局部来源"],"part":"original-reflow-page-08.png","renderedPage":8,"pageNumberConvention":"同摘要原件的既有重排页号；原冻结定位另存"},"quote":"同字节复用已交局部原页或原生对象；开放任务、源错误与编辑补足分别保留。未重转原件、未作整源审校。","resource":{"url":"r80/assets/44ca98d43d4415064d4cd191.png","bytes":466481,"sha256":"44ca98d43d4415064d4cd1910291b5a25717f42add715dad821db5feaad57c6f","sourceId":"U06","kind":"same_hash_original_reflow_page"},"originalUrl":"source-original/U06.docx","originalPdfUrl":"source-original/dot-r10/8e760780f3ae5fca7389b55a.pdf"},