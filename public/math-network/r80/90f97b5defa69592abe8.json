b5ae9013","locator":{"headingPath":["随机思想及从特殊到一般的教学概括"],"part":"word/document.xml","paragraphIndex":183,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":15,"printedPage":null,"pdfPage":15,"equationObjectId":null},"quote":"知识：确定性现象、随机现象、随机试验．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"L067","requestedPath":"increments/u05-u08-l041-l068-v1/evidence/L067/page-15.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/L067.docx","sourceTitle":"12.1 随机现象与样本空间（1）-教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:book3:L067:para184:random-thought-introduction:8","sourceId":"L067","sourceSha256":"72b7f9756efb6ea007ba77376bec5d15b5e0bec575fade6d8d278ec4b5ae9013","locator":{"headingPath":["随机思想及从特殊到一般的教学概括"],"part":"word/document.xml","paragraphIndex":184,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":15,"printedPage":null,"pdfPage":15,"equationObjectId":null},"quote":"思想方法：特殊到一般、随机思想．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"L067","requestedPath":"increments/u05-u08-l041-l068-v1/evidence/L067/page-15.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/L067.docx","sourceTitle":"12.1 随机现象与样本空间（1）-教学设计","sourceStatus":"partially_reviewed"}],"bodyAssets":{},"formulaRecords":[]},{"id":"lesson-content:book3:L067:random-phenomenon-concept","nodeId":"kp:21333","proposedNodeId":"proposed:book3:random-phenomenon","kind":"context","origin":"lesson_plan_verbatim","title":"随机现象与可重复随机试验的教案说明","scope":"L067相应具体问题或教学活动；此范围说明为编辑文字","blocks":[{"role":"context","type":"text","value":"【编辑订正原文首句】现实世界有具有确定性的现象，对它我们可以预见确切的结果，但更多的是不确定性现象，也就是无法预知确切结果的现象，俗语说：天有不测风云，人有旦夕祸福，许多事情人们无法预知，更无法掌控．我们把具有不确定性的现象称为随机现象(random phenomenon)，或者说现象具有随机性．","evidenceIds":["ev:book3:L067:para28:random-phenomenon-concept:0"]},{"role":"question","type":"text","value":"[问题2]请你列举几个生活中的随机现象的例子．","evidenceIds":["ev:book3:L067:para30:random-phenomenon-concept:1"]},{"role":"solution","type":"text","value":"生 我觉得下面的几个现象是随机现象","evidenceIds":["ev:book3:L067:para31:random-phenomenon-concept:2"]},{"role":"solution","type":"text","value":"掷一颗骰子，骰子落地后朝上的点数；","evidenceIds":["ev:book3:L067:para32:random-phenomenon-concept:3"]},{"role":"solution","type":"text","value":"购买彩票，彩票中奖．","evidenceIds":["ev:book3:L067:para33:random-phenomenon-concept:4"]},{"role":"solution","type":"text","value":"现实中有很多不同类型的随机现象．简单分为可随意重复的，如抛掷硬币、掷骰子、抽签等，称为随机试验；与不可随意重复的，如天气、动物寿命等．它们的研究方法也不尽相同．","evidenceIds":["ev:book3:L067:para34:random-phenomenon-concept:5"]}],"matching":{"status":"confirmed","reason":"该具体任务与既有节点对应"},"evidence":[{"id":"ev:book3:L067:para28:random-phenomenon-concept:0","sourceId":"L067","sourceSha256":"72b7f9756efb6ea007ba77376bec5d15b5e0bec575fade6d8d278ec4b5ae9013","locator":{"headingPath":["随机现象与可重复随机试验的教案说明"],"part":"word/document.xml","paragraphIndex":28,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":3,"printedPage":null,"pdfPage":3,"equationObjectId":null,"renderedPageEnd":4,"pdfPageEnd":4},"quote":"现实世界有具不确定性的现象，对它我们可以预见确切的结果，但更多的是不确定性现象，也就是无法预知确切结果的现象，俗语说：天有不测风云，人有旦夕祸福，许多事情人们无法预知，更无法掌控．我们把具有不确定性的现象称为随机现象(random phenomenon)，或者说现象具有随机性．","quoteRepresentation":"native_xml_text_verbatim","quoteCompleteness":"原XML文字层逐字拼接。","wordingChecked":true,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"L067","requestedPath":"increments/u05-u08-l041-l068-v1/evidence/L067/page-3.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/L067.docx","sourceTitle":"12.1 随机现象与样本空间（1）-教学设计","sourceStatus":"partially_reviewed"}