共点,那么它们有且只有一条过该点的公共直线。基本事实4:平行于同一条直线的两条直线平行。定理:如果空间中两个角的两条边分别对应平行,那么这两个角相等或互补。","wordingChecked":true,"mathChecked":false,"resource":{"url":"r80/assets/915bc28a1eb2f04d5e8dbe79.png","kind":"existing_local_original_pdf_page_preview","sha256":"915bc28a1eb2f04d5e8dbe79909e17f0c578cfaa0f42ff8da34d563ad95b5cac","bytes":317832,"sourceId":"S2025-PDF","sourceSha256":"fc9258bb37ed2e052a4b1be608865a5481f770ae7e28ce536e835d2354353f86","localOrigin":"/Users/yichen.zhang/vibe coding/codex/projects/数学教育平台/math-network-site/r80/assets/915bc28a1eb2f04d5e8dbe79.png","requestedPath":"S2025-PDF PDF page30 / printed27","pdfPage":30,"printedPage":27},"originalPdfUrl":"source-original/S2025-PDF.pdf","originalUrl":"source-original/S2025-PDF.pdf","verificationScope":"Complete original clause, finite per-node content correspondence; no achievement or level inference.","sourceClauseId":"R1"}],"note":"不扩全部空间角、距离或其他定理。完整原句与旧接收记录保留，未推断学业质量/素养等级或关联。","mappingBasis":"direct_original_2025_content_clause_limited_to_covered_aspect","coveredAspect":"空间点线面位置关系的定义及原列基本事实","priorReceivedRecord":{"value":null,"originalWording":null,"scope":"task","status":"unresolved","sourceId":null,"sourceEdition":"2025-primary-pending","evidence":[],"note":"教案目标及等级不替代2025直接依据。"}},"academicQualityLevel":{"value":null,"originalWording":null,"scope":"task","status":"unresolved","sourceId":null,"sourceEdition":"2025-primary-pending","evidence":[],"note":"教案目标及等级不替代2025直接依据。"},"competencyLevel":{"value":null,"originalWording":null,"scope":"task","status":"unresolved","sourceId":null,"sourceEdition":"2025-primary-pending","evidence":[],"note":"教案目标及等级不替代2025直接依据。"},"competencyLinks":{"value":null,"originalWording":null,"scope":"task","status":"unresolved","sourceId":null,"sourceEdition":"2025-primary-pending","evidence":[],"note":"教案目标及等级不替代2025直接依据。"}},"methodCandidates":[],"relationProposals":[],"legacyFormulaRecords":[]}
