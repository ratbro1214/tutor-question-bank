e}],"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U17","requestedPath":"increments/u17-v1/evidence/U17/page-19.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U17.docx","sourceTitle":"第18单元 教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:cross-omission:U17:p241","sourceId":"U17","sourceSha256":"ff41e1297a5bfbce8879a537e793d14df0d9b3e2d2a149c9a1bc1443a9869b9f","locator":{"headingPath":["U17","跨册限定遗漏重建"],"part":"word/document.xml","paragraphIndex":241,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":13,"printedPage":null,"equationObjectId":null,"renderedPageEnd":14,"printedPageNote":"完整源页无可见印刷页码；保持null。"},"quote":"假设某班级共有30人，那么这个班级至少有2人生日相同的概率是多少？因为每个人的生日有可能是365天（为了简单起见，假设一年只有365天）中的任意一天，这样一来，只有人数超过365时，我们才能百分百地肯定至少有两个人的生日相同，因此感觉上前述问题中的概率应该不会很大．不过，令人惊讶的是，利用排列组合的知识可以算出，30个人中，至少有两个人生日相同的概率约为71%．","wordingChecked":true,"mathChecked":false,"mathSourceAsset":null,"mathSourceAssets":[],"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"U17","requestedPath":"increments/u17-v1/evidence/U17/page-13.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/U17.docx","sourceTitle":"第18单元 教学设计","sourceStatus":"partially_reviewed"}],"bodyAssets":{},"formulaRecords":[{"id":"formula:cross-omission:U17:F0","location":"blocks[0].value:inlineMath[0]","sourceString":"问题推广：$n$个人组成的人群中恰好有两个人生日相同的概率是多少？","latex":"n","status":"verified"}]}],"requirements":{},"methodCandidates":[],"relationProposals":[],"legacyFormulaRecords":[]}