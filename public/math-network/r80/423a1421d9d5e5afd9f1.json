"role":"solution","type":"text","value":"（2）$\\bar y=\\frac1n\\sum_{i=1}^n y_i=\\frac1n\\sum_{i=1}^n(kx_i)=\\frac kn\\sum_{i=1}^n x_i=k\\bar x$，","evidenceIds":["ev:book3:L084:affine-variance-proof:para363"]},{"role":"solution","type":"text","value":"$s_y^2=\\frac1n\\sum_{i=1}^n(y_i-\\bar y)^2=\\frac1n\\sum_{i=1}^n(kx_i-k\\bar x)^2=\\frac{k^2}n\\sum_{i=1}^n(x_i-\\bar x)^2=k^2s_x^2$。","evidenceIds":["ev:book3:L084:affine-variance-proof:para364"]}],"wordingStatus":"source_based_editorial_transcription","matching":{"status":"confirmed","reason":"按具体内容用途匹配既有知识实体；不依赖类型标签"},"evidence":[{"id":"ev:book3:L084:affine-variance-proof:para330","sourceId":"L084","sourceSha256":"ff365c5b9619aa696cd783ce529412647c7d0f4c9db99fcf6e1e45e5e6245d91","locator":{"headingPath":["统计估计（2）","平移与倍乘样本方差性质的完整证明"],"part":"word/document.xml","paragraphIndex":330,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":16,"printedPage":null,"pdfPage":16,"equationObjectId":null},"quote":"4. 数据的方差为，数据的方差为，、为常数．","wordingStatus":"source_based_editorial_transcription","wordingChecked":false,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetainedInOriginalJson":true,"resource":{"url":null,"sourceId":"L084","requestedPath":"increments/u05-u08-l041-l076-l084-v1/evidence/L084/page-16.png","kind":"missing_source_page","sha256":null,"bytes":null},"originalUrl":"source-original/L084.docx","sourceTitle":"12.5 统计估计（2）-教学设计","sourceStatus":"partially_reviewed"},{"id":"ev:book3:L084:affine-variance-proof:para331","sourceId":"L084","sourceSha256":"ff365c5b9619aa696cd783ce529412647c7d0f4c9db99fcf6e1e45e5e6245d91","locator":{"headingPath":["统计估计（2）","平移与倍乘样本方差性质的完整证明"],"part":"word/document.xml","paragraphIndex":331,"tableIndex":null,"rowIndex":null,"cellIndex":null,"renderedPage":16,"printedPage":null,"pdfPage":16,"equationObjectId":null},"quote":"（1）如果、、…、，那么；","wordingStatus":"source_based_editorial_transcription","wordingChecked":false,"mathChecked":true,"mathSourceAsset":null,"rawMetadataRetaine